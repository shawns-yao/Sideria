# Copy outside the repository with mode 0600, then supply values locally.
SIDERIA_SERVER_URL=https://sideria.example.invalid
SIDERIA_AGENT_STATE=/var/lib/sideria
SIDERIA_FILE_ROOT=/srv/sideria
SIDERIA_SAMPLE_INTERVAL=5s
# One-time enrollment only; remove after identity.json has been persisted.
SIDERIA_ENROLLMENT_TOKEN=
# Explicit optional grants. Docker socket access has host-level impact.
SIDERIA_ALLOW_TERMINAL=0
SIDERIA_DOCKER_SOCKET=
# Aggregate upload+download payload budget per Agent, 32 KiB burst.
SIDERIA_TRANSFER_BYTES_PER_SECOND=1048576
SIDERIA_TRANSFER_MAX_BYTES=33554432
SIDERIA_TRANSFER_CONCURRENCY=2
