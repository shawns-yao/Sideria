SIDERIA_LISTEN=127.0.0.1:8443
SIDERIA_TLS_CERT=/etc/sideria/tls.crt
SIDERIA_TLS_KEY=/etc/sideria/tls.key
SIDERIA_ADMIN_TOKEN=
DATABASE_URL=postgres://sideria@127.0.0.1/sideria?sslmode=verify-full
REDIS_URL=rediss://127.0.0.1:6379/0
SIDERIA_TRANSFER_DIR=/var/lib/sideria/transfers
# No model calls until credentials, endpoint and authorized egress are configured.
SIDERIA_AI_URL=https://api.openai.com/v1
SIDERIA_AI_MODEL=
SIDERIA_AI_KEY=
SIDERIA_AI_ALLOW_EGRESS=0
